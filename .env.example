# Configurações de Aquisição e Integrações - Dendrix CRM
# Copie este arquivo para .env.local e preencha com seus dados reais:

# URL do evento oficial no Cal.com para agendamento de 15 minutos:
# Exemplo: https://cal.com/seu-usuario/demonstracao-15min
NEXT_PUBLIC_CAL_URL=

# Número de WhatsApp do atendimento comercial com DDI e DDD (somente dígitos):
# Exemplo: 5511999998888
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Endpoint Webhook para envio dos dados do lead (n8n, Make, Supabase, CRM):
# Exemplo: https://webhook.seuservidor.com/webhook/dendrix-leads
NEXT_PUBLIC_LEAD_WEBHOOK_URL=
